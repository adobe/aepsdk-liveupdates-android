.idea/

code/.gradle/
code/messaging/build/
code/local.properties

# Keystore files
# Uncomment the following line if you do not want to check your keystore files in.
#*.jks

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild

# Google Services (e.g. APIs or Firebase) - real google-services.json files stay
# local-only; the sample app ships a masked template at code/testapp/google-services.json
# which is explicitly exempted below.
google-services.json
!code/testapp/google-services.json

# .Idea file
code/.idea*
code/testapp/.idea*

# sdk-build
sdk-build
# unit test generated files
code/messaging/mock_cache/*
# jacoco generated file
code/messaging/jacoco.exec

.vscode/
code/messaging/cache/

code/liveupdates/build/
code/liveupdates/mock_cache/*
code/liveupdates/jacoco.exec

# Firebase service-account key — never commit.
fcm-key.json

# Local-only Firebase config (real values). The sample app ships a masked
# google-services.json template; this exempts the testapp's template from the
# general rule above while still blocking copies dropped anywhere else.
**/google-services.json
!code/testapp/google-services.json

# Local FCM helper scripts and Postman collections (developer-only tooling).
fcm*.sh
demo-curl.sh
*.postman_collection.json
*.postman_environment.json
.scout/
