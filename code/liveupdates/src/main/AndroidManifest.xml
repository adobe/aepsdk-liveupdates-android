<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Required since Android 13 (API 33) to post any notification.
        Declared here so it merges into the consumer app's manifest automatically;
        the customer app is responsible for requesting this permission at runtime.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Required to request promotion of a notification to the status bar chip
        (Live Updates / promoted ongoing). This is a non-runtime permission —
        the system grants it at install time; no user prompt is shown.
    -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application>

        <!--
            Interception activity for Live Update chip taps and action-button clicks.
            Runs transparently, fires tracking via LiveUpdates.handleNotificationResponse,
            forwards to the destination URI (or the host app's launcher activity), and
            finishes. singleInstance keeps it off the app's normal task stack.
        -->
        <activity
            android:name="com.adobe.marketing.mobile.messaging.liveupdate.LiveUpdateTrackerActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
            Delete-intent target for Live Update dismissals. Fires dismiss tracking with
            customActionId = "Dismiss" via LiveUpdates.handleNotificationResponse.
        -->
        <receiver
            android:name="com.adobe.marketing.mobile.messaging.liveupdate.LiveUpdateInteractionReceiver"
            android:exported="false" />

    </application>

</manifest>
